@page "/dividendi"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.Services
@using EtoroPortfolioHub.State
@inject DividendCalendarService DividendCalendarService
@inject PortfolioState PortfolioState

<PageTitle>Dividendi</PageTitle>

<h3 class="mb-3">Dividendi</h3>

@if (_isLoading)
{
    <div class="alert alert-info">
        Caricamento dati dividendi...
    </div>
}
else
{
    <!-- KPI -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Entrate stimate questo mese</div>
                    <div class="fs-4 fw-bold">@_thisMonthTotal.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Entrate stimate prossimo mese</div>
                    <div class="fs-4 fw-bold">@_nextMonthTotal.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Entrate stimate annuali</div>
                    <div class="fs-4 fw-bold">@_annualTotal.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Prossimo pagamento in arrivo</div>
                    <div class="fw-bold">
                        @(_nextPaymentLabel ?? "-")
                    </div>
                    <div class="small text-muted mt-1">
                        @(_nextPaymentAmount.HasValue ? _nextPaymentAmount.Value.ToString("N2") : "")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messaggi -->
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">
            @_message
        </div>
    }

    <!-- Nota -->
    <div class="alert alert-light border mb-4">
        <strong>Nota:</strong>
        ogni record rappresenta <strong>un singolo pagamento dividendo</strong>.
        Quindi, se un titolo paga 4 volte l’anno, vanno inseriti 4 record distinti con date diverse.
        Le entrate mostrate sono una <strong>stima lorda</strong> basata sulle unità attualmente in portafoglio.
    </div>

    <div class="row g-4 mb-4">
        <!-- Form inserimento / modifica -->
        <div class="col-xl-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">
                            @(_editModel.Id == 0 ? "Nuovo dividendo" : "Modifica dividendo")
                        </h5>

                        @if (_editModel.Id != 0)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetForm">
                                Nuovo
                            </button>
                        }
                    </div>

                    <EditForm Model="_editModel" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Titolo in portafoglio</label>
                            <select class="form-select"
                                    value="@GetSelectedInstrumentValue()"
                                    @onchange="OnPortfolioSelectionChanged">
                                <option value="">-- Seleziona un titolo --</option>

                                @foreach (var item in _portfolioOptions)
                                {
                                    <option value="@item.InstrumentId">
                                        @item.Symbol - @item.InstrumentName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Simbolo</label>
                            <InputText @bind-Value="_editModel.Symbol" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nome società</label>
                            <InputText @bind-Value="_editModel.CompanyName" class="form-control" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Settore</label>
                            <InputText @bind-Value="_editModel.Sector" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Instrument ID</label>
                            <InputNumber @bind-Value="_editModel.InstrumentId"
                                         class="form-control"
                                         TValue="int?"
                                         readonly />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Ex-Dividend Date</label>
                                <InputDate @bind-Value="_editModel.ExDividendDate"
                                           class="form-control"
                                           TValue="DateTime?" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Payment Date</label>
                                <InputDate @bind-Value="_editModel.PaymentDate"
                                           class="form-control"
                                           TValue="DateTime?" />
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">Annual Dividend</label>
                                <InputNumber @bind-Value="_editModel.AnnualDividend"
                                             class="form-control"
                                             TValue="decimal" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Periodic Dividend</label>
                                <InputNumber @bind-Value="_editModel.PeriodicDividend"
                                             class="form-control"
                                             TValue="decimal" />
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label class="form-label">Note</label>
                            <InputTextArea @bind-Value="_editModel.Notes"
                                           class="form-control"
                                           rows="3" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @(_isSaving ? "Salvataggio..." : "Salva")
                            </button>

                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm" disabled="@_isSaving">
                                Annulla
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Eventi dividendo salvati -->
        <div class="col-xl-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Eventi dividendo salvati</h5>
                        <span class="badge text-bg-secondary">@_allEvents.Count record</span>
                    </div>

                    @if (_allEvents.Count == 0)
                    {
                        <div class="text-muted">
                            Nessun evento dividendo salvato.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Simbolo</th>
                                        <th>Società</th>
                                        <th>Ex-Date</th>
                                        <th>Payment Date</th>
                                        <th class="text-end">Annual</th>
                                        <th class="text-end">Periodic</th>
                                        <th style="width: 160px;">Azioni</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _allEvents)
                                    {
                                        <tr>
                                            <td><strong>@item.Symbol</strong></td>
                                            <td>@item.CompanyName</td>
                                            <td>@(item.ExDividendDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>@(item.PaymentDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="text-end">@item.AnnualDividend.ToString("N4")</td>
                                            <td class="text-end">@item.PeriodicDividend.ToString("N4")</td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => EditAsync(item.Id)">
                                                        Modifica
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-danger"
                                                            @onclick="() => DeleteAsync(item.Id)">
                                                        Elimina
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Titoli in portafoglio che generano dividendi -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Titoli in portafoglio con dividendi</h5>

            @if (_dividendPositions.Count == 0)
            {
                <div class="text-muted">
                    Nessun titolo del portafoglio corrisponde ai dividendi salvati.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Titolo</th>
                                <th class="text-end">Units</th>
                                <th class="text-end">Periodic</th>
                                <th class="text-end">Annual</th>
                                <th>Ex-Date</th>
                                <th>Payment Date</th>
                                <th class="text-end">Entrata lorda stimata</th>
                                <th>Frequenza</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _dividendPositions)
                            {
                                <tr>
                                    <td>
                                        <div><strong>@item.Symbol</strong></div>
                                        <div class="text-muted small">@item.InstrumentName</div>
                                        <div class="text-muted small">@item.Sector</div>
                                    </td>
                                    <td class="text-end">@item.UnitsHeld.ToString("N2")</td>
                                    <td class="text-end">@item.PeriodicDividend.ToString("N4")</td>
                                    <td class="text-end">@item.AnnualDividend.ToString("N4")</td>
                                    <td>@(item.ExDividendDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@(item.PaymentDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td class="text-end">@item.EstimatedGrossAmount.ToString("N2")</td>
                                    <td>@item.FrequencyLabel</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Calendario mensile -->
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Calendario mensile entrate da dividendo</h5>

            @if (_monthlySummaries.Count == 0)
            {
                <div class="text-muted">
                    Nessuna entrata da dividendo stimata disponibile.
                </div>
            }
            else
            {
                @foreach (var month in _monthlySummaries)
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 text-capitalize">@month.Label</h6>
                            <span class="badge text-bg-primary">
                                @month.EstimatedGrossTotal.ToString("N2")
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Titolo</th>
                                        <th>Payment Date</th>
                                        <th class="text-end">Entrata lorda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in month.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div><strong>@item.Symbol</strong></div>
                                                <div class="text-muted small">@item.InstrumentName</div>
                                            </td>
                                            <td>@(item.PaymentDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td class="text-end">@item.EstimatedGrossAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isError = false;

    private string? _message;

    private List<DividendEventItem> _allEvents = new();
    private List<DividendCalendarItemDto> _dividendPositions = new();
    private List<DividendMonthlySummaryDto> _monthlySummaries = new();

    private decimal _thisMonthTotal;
    private decimal _nextMonthTotal;
    private decimal _annualTotal;

    private string? _nextPaymentLabel;
    private decimal? _nextPaymentAmount;

    private DividendEventItem _editModel = CreateNewModel();

    private List<PortfolioOptionVm> _portfolioOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _message = null;
        _isError = false;

        try
        {
            LoadPortfolioOptions();

            _allEvents = await DividendCalendarService.GetAllAsync();
            _dividendPositions = await DividendCalendarService.GetDividendPositionsAsync();
            _monthlySummaries = await DividendCalendarService.GetMonthlySummariesAsync();

            var today = DateTime.Today;
            var thisMonth = new DateTime(today.Year, today.Month, 1);
            var nextMonth = thisMonth.AddMonths(1);

            _thisMonthTotal = _monthlySummaries
                .Where(x => x.Year == thisMonth.Year && x.Month == thisMonth.Month)
                .Sum(x => x.EstimatedGrossTotal);

            _nextMonthTotal = _monthlySummaries
                .Where(x => x.Year == nextMonth.Year && x.Month == nextMonth.Month)
                .Sum(x => x.EstimatedGrossTotal);

            _annualTotal = Math.Round(_dividendPositions.Sum(x => x.AnnualDividend * x.UnitsHeld), 2);

            var nextPayment = _dividendPositions
                .Where(x => x.PaymentDate.HasValue && x.PaymentDate.Value.Date >= today)
                .OrderBy(x => x.PaymentDate)
                .FirstOrDefault();

            if (nextPayment is not null)
            {
                _nextPaymentLabel = $"{nextPayment.Symbol} - {nextPayment.PaymentDate:dd/MM/yyyy}";
                _nextPaymentAmount = nextPayment.EstimatedGrossAmount;
            }
            else
            {
                _nextPaymentLabel = null;
                _nextPaymentAmount = null;
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Errore durante il caricamento dei dividendi: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void LoadPortfolioOptions()
    {
        var snapshot = PortfolioState.GetSnapshot();

        _portfolioOptions = snapshot.Positions
            .Where(p => p.IsBuy)
            .Select(p => new PortfolioOptionVm
            {
                InstrumentId = p.InstrumentId,
                Symbol = p.Symbol,
                InstrumentName = p.InstrumentName
            })
            .GroupBy(x => x.InstrumentId)
            .Select(g => g.First())
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _message = null;
        _isError = false;

        try
        {
            ValidateModel(_editModel);

            await DividendCalendarService.SaveOrUpdateAsync(_editModel);

            _message = _editModel.Id == 0
                ? "Evento dividendo salvato correttamente."
                : "Evento dividendo aggiornato correttamente.";

            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Errore durante il salvataggio: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task EditAsync(int id)
    {
        _message = null;
        _isError = false;

        var item = await DividendCalendarService.GetByIdAsync(id);

        if (item is null)
        {
            _isError = true;
            _message = "Evento dividendo non trovato.";
            return;
        }

        _editModel = new DividendEventItem
        {
            Id = item.Id,
            InstrumentId = item.InstrumentId,
            Symbol = item.Symbol,
            CompanyName = item.CompanyName,
            Sector = item.Sector,
            ExDividendDate = item.ExDividendDate,
            PaymentDate = item.PaymentDate,
            AnnualDividend = item.AnnualDividend,
            PeriodicDividend = item.PeriodicDividend,
            Notes = item.Notes
        };
    }

    private async Task DeleteAsync(int id)
    {
        _message = null;
        _isError = false;

        try
        {
            await DividendCalendarService.DeleteAsync(id);

            if (_editModel.Id == id)
            {
                ResetForm();
            }

            _message = "Evento dividendo eliminato correttamente.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Errore durante l'eliminazione: {ex.Message}";
        }
    }

    private void ResetForm()
    {
        _editModel = CreateNewModel();
    }

    private string GetSelectedInstrumentValue()
    {
        return _editModel.InstrumentId?.ToString() ?? string.Empty;
    }

    private void OnPortfolioSelectionChanged(ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(rawValue))
        {
            _editModel.InstrumentId = null;
            _editModel.Symbol = string.Empty;
            _editModel.CompanyName = string.Empty;
            return;
        }

        if (!int.TryParse(rawValue, out var instrumentId))
            return;

        var selected = _portfolioOptions.FirstOrDefault(x => x.InstrumentId == instrumentId);
        if (selected is null)
            return;

        _editModel.InstrumentId = selected.InstrumentId;
        _editModel.Symbol = selected.Symbol;
        _editModel.CompanyName = selected.InstrumentName;
    }

    private static DividendEventItem CreateNewModel()
    {
        return new DividendEventItem
        {
            AnnualDividend = 0m,
            PeriodicDividend = 0m
        };
    }

    private static void ValidateModel(DividendEventItem model)
    {
        if (string.IsNullOrWhiteSpace(model.Symbol))
            throw new InvalidOperationException("Seleziona un titolo in portafoglio.");

        if (string.IsNullOrWhiteSpace(model.CompanyName))
            throw new InvalidOperationException("Il nome società è obbligatorio.");

        if (!model.PaymentDate.HasValue)
            throw new InvalidOperationException("La Payment Date è obbligatoria.");

        if (model.ExDividendDate.HasValue && model.PaymentDate.HasValue &&
            model.PaymentDate.Value.Date < model.ExDividendDate.Value.Date)
        {
            throw new InvalidOperationException("La Payment Date non può essere precedente alla Ex-Dividend Date.");
        }

        if (model.AnnualDividend < 0)
            throw new InvalidOperationException("Annual Dividend non può essere negativo.");

        if (model.PeriodicDividend < 0)
            throw new InvalidOperationException("Periodic Dividend non può essere negativo.");
    }

    private sealed class PortfolioOptionVm
    {
        public int InstrumentId { get; set; }
        public string Symbol { get; set; } = string.Empty;
        public string InstrumentName { get; set; } = string.Empty;
    }
}
``