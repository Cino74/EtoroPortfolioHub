@page "/portfolio-targets"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.Services
@using EtoroPortfolioHub.State
@inject PortfolioState PortfolioState
@inject PortfolioTargetService PortfolioTargetService

<PageTitle>Target Portafoglio</PageTitle>

<h3 class="mb-3">Target Portafoglio</h3>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div class="btn-group" role="group" aria-label="Filtro categoria">
        <button type="button"
                class="btn @(IsSelectedCategory("TUTTI") ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => SetCategoryFilter("TUTTI")'>
            TUTTI
        </button>

        <button type="button"
                class="btn @(IsSelectedCategory("ETF") ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => SetCategoryFilter("ETF")'>
            ETF
        </button>

        <button type="button"
                class="btn @(IsSelectedCategory("AZIONI") ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => SetCategoryFilter("AZIONI")'>
            AZIONI
        </button>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_isBusy">
            Aggiorna
        </button>

        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_isBusy">
            Salva target
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")">
        @_message
    </div>
}

@if (_isBusy && _rows.Count == 0)
{
    <div class="alert alert-info">
        Caricamento dati...
    </div>
}
else
{
    var filteredRows = GetFilteredRows();

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Titoli filtrati</div>
                    <div class="fs-4 fw-bold">@filteredRows.Count</div>
                </div>
            </div>
        </div>
    </div>

    @if (TotalTarget > 100m)
    {
        <div class="alert alert-warning">
            Il totale complessivo dei target supera il 100%.
        </div>
    }

    @if (filteredRows.Count == 0)
    {
        <div class="alert alert-warning">
            Nessun titolo disponibile per il filtro selezionato.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Titolo</th>
                        <th>Categoria</th>
                        <th class="text-end">Totale investito</th>
                        <th class="text-end">Peso attuale %</th>
                        <th class="text-end">Target %</th>
                        <th class="text-end">Delta %</th>
                        <th class="text-end">Delta valore</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in filteredRows)
                    {
                        <tr>
                            <td>
                                <div><strong>@row.Symbol</strong></div>
                                <div class="text-muted small">@row.InstrumentName</div>
                                <div class="text-muted small">ID: @row.InstrumentId</div>
                            </td>

                            <td>
                                <span class="badge @(row.Category == "ETF" ? "text-bg-info" : row.Category == "AZIONI" ? "text-bg-secondary" : "text-bg-light")">
                                    @row.Category
                                </span>
                            </td>

                            <td class="text-end">@row.CurrentInvestedAmount.ToString("N2")</td>

                            <td class="text-end">
                                @row.CurrentWeightPercentage.ToString("N2") %
                            </td>

                            <td class="text-end" style="min-width: 140px;">
                                <InputNumber @bind-Value="row.TargetPercentage"
                                             class="form-control text-end"
                                             TValue="decimal"
                                             step="0.01" />
                            </td>

                            <td class="text-end @(row.DeltaPercentage >= 0 ? "text-success" : "text-danger")">
                                @row.DeltaPercentage.ToString("N2") %
                            </td>

                            <td class="text-end @(row.DeltaValue >= 0 ? "text-success" : "text-danger")">
                                @row.DeltaValue.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <th colspan="4" class="text-end">Totale target filtrato</th>
                        <th class="text-end @(FilteredTotalTarget > 100m ? "text-danger" : "text-success")">
                            @FilteredTotalTarget.ToString("N2") %
                        </th>
                        <th colspan="2"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@code {
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    private List<PortfolioTargetRowVm> _rows = new();
    private string _selectedCategory = "TUTTI";

    private decimal TotalTarget => _rows.Sum(x => x.TargetPercentage);

    private decimal FilteredTotalTarget => GetFilteredRows().Sum(x => x.TargetPercentage);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            var snapshot = PortfolioState.GetSnapshot();
            var savedTargets = await PortfolioTargetService.GetAllAsync();

            var totalInvestedPortfolio = snapshot.Positions.Sum(x => x.InvestedAmount);

            _rows = snapshot.Positions
                .GroupBy(p => p.InstrumentId)
                .Select(g =>
                {
                    var investedForInstrument = g.Sum(x => x.InvestedAmount);

                    savedTargets.TryGetValue(g.Key, out var savedTarget);

                    var targetPercentage = savedTarget?.TargetPercentage ?? 0m;
                    var currentWeight = totalInvestedPortfolio == 0m
                        ? 0m
                        : Math.Round(investedForInstrument / totalInvestedPortfolio * 100m, 2);

                    var instrumentTypeDescription =
                        g.Select(x => x.InstrumentTypeDescription)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                        ?? string.Empty;

                    return new PortfolioTargetRowVm
                    {
                        InstrumentId = g.Key,
                        Symbol = g.Select(x => x.Symbol).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? g.Key.ToString(),
                        InstrumentName = g.Select(x => x.InstrumentName).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? $"Strumento {g.Key}",
                        Category = NormalizeCategory(instrumentTypeDescription),
                        CurrentInvestedAmount = investedForInstrument,
                        TotalPortfolioInvested = totalInvestedPortfolio,
                        CurrentWeightPercentage = currentWeight,
                        TargetPercentage = targetPercentage
                    };
                })
                .OrderBy(x => x.Symbol)
                .ToList();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Errore durante il caricamento: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        _isBusy = true;
        _isError = false;
        _message = null;

        try
        {
            var items = _rows
                .Select(x => new PortfolioTargetItem
                {
                    InstrumentId = x.InstrumentId,
                    Symbol = x.Symbol,
                    InstrumentName = x.InstrumentName,
                    TargetPercentage = Math.Round(x.TargetPercentage, 2)
                })
                .ToList();

            await PortfolioTargetService.SaveAllAsync(items);

            _message = "Target salvati correttamente.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Errore durante il salvataggio: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void SetCategoryFilter(string category)
    {
        _selectedCategory = category;
    }

    private bool IsSelectedCategory(string category)
    {
        return string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase);
    }

    private List<PortfolioTargetRowVm> GetFilteredRows()
    {
        if (string.Equals(_selectedCategory, "TUTTI", StringComparison.OrdinalIgnoreCase))
            return _rows.OrderBy(x => x.Symbol).ToList();

        return _rows
            .Where(x => string.Equals(x.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    private static string NormalizeCategory(string instrumentTypeDescription)
    {
        if (string.IsNullOrWhiteSpace(instrumentTypeDescription))
            return "ALTRO";

        var value = instrumentTypeDescription.Trim().ToUpperInvariant();

        if (value.Contains("ETF"))
            return "ETF";

        if (value.Contains("STOCK"))
            return "AZIONI";

        return value;
    }

    private sealed class PortfolioTargetRowVm
    {
        public int InstrumentId { get; set; }

        public string Symbol { get; set; } = string.Empty;
        public string InstrumentName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;

        public decimal CurrentInvestedAmount { get; set; }
        public decimal TotalPortfolioInvested { get; set; }

        public decimal CurrentWeightPercentage { get; set; }
        public decimal TargetPercentage { get; set; }

        public decimal DeltaPercentage =>
            Math.Round(TargetPercentage - CurrentWeightPercentage, 2);

        public decimal TargetValue =>
            Math.Round(TotalPortfolioInvested * TargetPercentage / 100m, 2);

        public decimal DeltaValue =>
            Math.Round(TargetValue - CurrentInvestedAmount, 2);
    }
}