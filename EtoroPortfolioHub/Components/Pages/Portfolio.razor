@page "/portfolio"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.State
@using EtoroPortfolioHub.Components.Shared
@using Microsoft.Extensions.Options
@inject PortfolioState PortfolioState
@inject IOptionsMonitor<EtoroOptions> EtoroOptionsMonitor

@implements IAsyncDisposable

<PageTitle>Portfolio</PageTitle>

<h3 class="mb-3">Portafoglio</h3>

<div class="mb-3">
    <span class="badge text-bg-secondary">
        Refresh ogni @_refreshIntervalSeconds secondi
    </span>
</div>

@if (_snapshot is null)
{
    <div class="alert alert-info">
        Caricamento dati...
    </div>
}
else
{
    <PortfolioSummaryCards Snapshot="_snapshot"
                           TitlesCount="_groupedRows.Count"
                           TotalInvested="_groupedRows.Sum(x => x.TotalInvested)" />

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div>
                <strong>Ultimo aggiornamento locale:</strong>
                @_snapshot.LastUpdated.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        </div>
    </div>

    @if (_groupedRows.Count == 0)
    {
        <div class="alert alert-warning">
            Nessuna posizione disponibile.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Titolo</th>
                        <th>Direzione</th>
                        <th>Posizioni</th>
                        <th>Totale investito</th>
                        <th>Totale units</th>
                        <th>Prezzo medio</th>
                        <th>Prezzo attuale</th>
                        <th>Leverage medio</th>
                        <th>Take Profit medio</th>
                        <th>Stop Loss medio</th>
                        <th>P/L totale</th>
                        <th>P/L %</th>
                        <th>Ultima apertura</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _groupedRows)
                    {
                        <tr class="@(IsExpanded(row.InstrumentId) ? "table-active" : "")">
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Espandi / comprimi"
                                        @onclick="() => ToggleRow(row.InstrumentId)">
                                    @(IsExpanded(row.InstrumentId) ? "−" : "+")
                                </button>
                            </td>

                            <td>
                                <div><strong>@row.Symbol</strong></div>
                                <div class="text-muted small">@row.InstrumentName</div>
                                <div class="text-muted small">ID: @row.InstrumentId</div>
                            </td>

                            <td>@row.Direction</td>
                            <td>@row.PositionsCount</td>
                            <td>@row.TotalInvested.ToString("N2")</td>
                            <td>@row.TotalUnits.ToString("N2")</td>
                            <td>@row.AverageOpenRate.ToString("N2")</td>
                            <td>@row.CurrentRate.ToString("N2")</td>
                            <td>@row.AverageLeverage.ToString("N2")</td>
                            <td>@row.AverageTakeProfitRate.ToString("N2")</td>
                            <td>@row.AverageStopLossRate.ToString("N2")</td>
                            <td class="@(row.TotalPnL >= 0 ? "text-success" : "text-danger")">
                                @row.TotalPnL.ToString("N2")
                            </td>
                            <td class="@(row.ProfitPercent >= 0 ? "text-success" : "text-danger")">
                                @row.ProfitPercent.ToString("N2") %
                            </td>
                            <td>
                                @(row.LastTimestamp?.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                            </td>
                        </tr>

                        @if (IsExpanded(row.InstrumentId))
                        {
                            var details = GetDetailsForInstrument(row.InstrumentId);

                            <tr>
                                <td colspan="14" class="bg-light">
                                    <div class="p-2">
                                        <div class="fw-semibold mb-2">
                                            Dettaglio posizioni - @row.Symbol (@details.Count)
                                        </div>

                                        @if (details.Count == 0)
                                        {
                                            <div class="text-muted">Nessun dettaglio disponibile.</div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Position ID</th>
                                                            <th>Direzione</th>
                                                            <th>Investito</th>
                                                            <th>Units</th>
                                                            <th>Open Rate</th>
                                                            <th>Prezzo attuale</th>
                                                            <th>Leverage</th>
                                                            <th>Take Profit</th>
                                                            <th>Stop Loss</th>
                                                            <th>P/L</th>
                                                            <th>P/L %</th>
                                                            <th>Timestamp</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var position in details)
                                                        {
                                                            <tr>
                                                                <td>@position.PositionId</td>
                                                                <td>@(position.IsBuy ? "LONG" : "SHORT")</td>
                                                                <td>@position.InvestedAmount.ToString("N2")</td>
                                                                <td>@position.Units.ToString("N2")</td>
                                                                <td>@position.OpenRate.ToString("N2")</td>
                                                                <td>@position.CurrentRate.ToString("N2")</td>
                                                                <td>@position.Leverage.ToString("N2")</td>
                                                                <td>@position.TakeProfitRate.ToString("N2")</td>
                                                                <td>@position.StopLossRate.ToString("N2")</td>
                                                                <td class="@(position.NetProfit >= 0 ? "text-success" : "text-danger")">
                                                                    @position.NetProfit.ToString("N2")
                                                                </td>
                                                                <td class="@(position.ProfitPercent >= 0 ? "text-success" : "text-danger")">
                                                                    @position.ProfitPercent.ToString("N2") %
                                                                </td>
                                                                <td>
                                                                    @(position.Timestamp?.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private PortfolioSnapshot? _snapshot;
    private List<PortfolioGroupedRowDto> _groupedRows = new();

    private readonly Dictionary<int, bool> _expandedRows = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private int _refreshIntervalSeconds;

    protected override async Task OnInitializedAsync()
    {
        _refreshIntervalSeconds = Math.Max(1, EtoroOptionsMonitor.CurrentValue.RefreshIntervalSeconds);

        await LoadSnapshotAsync();

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));

        _ = StartRefreshLoopAsync(_cts.Token);
    }

    private async Task StartRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadSnapshotAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // chiusura normale del componente
        }
    }

    private Task LoadSnapshotAsync()
    {
        _snapshot = PortfolioState.GetSnapshot();
        _groupedRows = BuildGroupedRows(_snapshot);

        var validIds = _groupedRows.Select(x => x.InstrumentId).ToHashSet();
        var keysToRemove = _expandedRows.Keys.Where(id => !validIds.Contains(id)).ToList();

        foreach (var key in keysToRemove)
        {
            _expandedRows.Remove(key);
        }

        return Task.CompletedTask;
    }

    private void ToggleRow(int instrumentId)
    {
        if (_expandedRows.ContainsKey(instrumentId))
        {
            _expandedRows[instrumentId] = !_expandedRows[instrumentId];
        }
        else
        {
            _expandedRows[instrumentId] = true;
        }
    }

    private bool IsExpanded(int instrumentId)
    {
        return _expandedRows.TryGetValue(instrumentId, out var expanded) && expanded;
    }

    private List<PositionDto> GetDetailsForInstrument(int instrumentId)
    {
        if (_snapshot is null)
            return new List<PositionDto>();

        return _snapshot.Positions
            .Where(p => p.InstrumentId == instrumentId)
            .OrderByDescending(p => p.Timestamp)
            .ThenByDescending(p => p.PositionId)
            .ToList();
    }

    private static List<PortfolioGroupedRowDto> BuildGroupedRows(PortfolioSnapshot snapshot)
    {
        return snapshot.Positions
            .GroupBy(p => p.InstrumentId)
            .Select(group =>
            {
                var totalInvested = group.Sum(x => x.InvestedAmount);
                var totalUnits = group.Sum(x => x.Units);
                var totalPnL = group.Sum(x => x.NetProfit);

                var weightedOpenRate = totalInvested == 0
                    ? 0
                    : group.Sum(x => x.OpenRate * x.InvestedAmount) / totalInvested;

                var weightedLeverage = totalInvested == 0
                    ? 0
                    : group.Sum(x => x.Leverage * x.InvestedAmount) / totalInvested;

                var weightedTakeProfit = totalInvested == 0
                    ? 0
                    : group.Sum(x => x.TakeProfitRate * x.InvestedAmount) / totalInvested;

                var weightedStopLoss = totalInvested == 0
                    ? 0
                    : group.Sum(x => x.StopLossRate * x.InvestedAmount) / totalInvested;

                var directions = group.Select(x => x.IsBuy ? "LONG" : "SHORT").Distinct().ToList();
                var direction = directions.Count == 1 ? directions[0] : "MIXED";

                return new PortfolioGroupedRowDto
                {
                    InstrumentId = group.Key,
                    Symbol = group.Select(x => x.Symbol).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? group.Key.ToString(),
                    InstrumentName = group.Select(x => x.InstrumentName).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? $"Strumento {group.Key}",
                    Direction = direction,
                    PositionsCount = group.Count(),
                    TotalInvested = totalInvested,
                    TotalUnits = totalUnits,
                    AverageOpenRate = Math.Round(weightedOpenRate, 2),
                    CurrentRate = Math.Round(
                        group.Where(x => x.CurrentRate != 0m)
                             .Select(x => x.CurrentRate)
                             .LastOrDefault(), 2),
                    AverageLeverage = Math.Round(weightedLeverage, 2),
                    AverageTakeProfitRate = Math.Round(weightedTakeProfit, 2),
                    AverageStopLossRate = Math.Round(weightedStopLoss, 2),
                    TotalPnL = Math.Round(totalPnL, 2),
                    ProfitPercent = totalInvested == 0 ? 0 : Math.Round(totalPnL / totalInvested * 100m, 2),
                    LastTimestamp = group.Max(x => x.Timestamp)
                };
            })
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();

        return ValueTask.CompletedTask;
    }
}