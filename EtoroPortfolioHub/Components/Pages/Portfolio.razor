@page "/portfolio"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.State
@using EtoroPortfolioHub.Components.Shared
@using Microsoft.Extensions.Options
@inject PortfolioState PortfolioState
@inject IOptionsMonitor<EtoroOptions> EtoroOptionsMonitor

@implements IAsyncDisposable

<PageTitle>Portfolio</PageTitle>

<h3 class="mb-3">Portafoglio</h3>

<div class="mb-3">
    <span class="badge text-bg-secondary">
        Refresh ogni @_refreshIntervalSeconds secondi
    </span>
</div>

@if (_snapshot is null)
{
    <div class="alert alert-info">
        Caricamento dati...
    </div>
}
else
{
    var filteredRows = GetFilteredRows();

    <PortfolioSummaryCards Snapshot="_snapshot"
                           TitlesCount="filteredRows.Count"
                           TotalInvested="filteredRows.Sum(x => x.TotalInvested)" />

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <strong>Ultimo aggiornamento locale:</strong>
                    @_snapshot.LastUpdated.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")
                </div>

                <div class="btn-group" role="group" aria-label="Filtro categoria">
                    <button type="button"
                            class="btn @(IsSelectedCategory("TUTTI") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("TUTTI")'>
                        TUTTI
                    </button>

                    <button type="button"
                            class="btn @(IsSelectedCategory("ETF") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("ETF")'>
                        ETF
                    </button>

                    <button type="button"
                            class="btn @(IsSelectedCategory("AZIONI") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("AZIONI")'>
                        AZIONI
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (filteredRows.Count == 0)
    {
        <div class="alert alert-warning">
            Nessun titolo disponibile per il filtro selezionato.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Titolo</th>
                        <th>Categoria</th>
                        <th>Direzione</th>
                        <th>Posizioni</th>
                        <th>Totale investito</th>
                        <th>Totale units</th>
                        <th>Prezzo medio</th>
                        <th>Prezzo attuale</th>
                        <th>P/L totale</th>
                        <th>P/L %</th>
                        <th>Ultima apertura</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in filteredRows)
                    {
                        <tr class="@(IsExpanded(row.InstrumentId) ? "table-active" : "")">
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick='() => ToggleRow(row.InstrumentId)'>
                                    @(IsExpanded(row.InstrumentId) ? "−" : "+")
                                </button>
                            </td>

                            <td>
                                <div><strong>@row.Symbol</strong></div>
                                <div class="text-muted small">@row.InstrumentName</div>
                                <div class="text-muted small">ID: @row.InstrumentId</div>
                            </td>

                            <td>
                                <span class="badge @(row.Category.Contains("ETF", StringComparison.OrdinalIgnoreCase) ? "text-bg-info" : "text-bg-secondary")">
                                    @row.Category
                                </span>
                            </td>

                            <td>@row.Direction</td>
                            <td>@row.PositionsCount</td>
                            <td>@row.TotalInvested.ToString("N2")</td>
                            <td>@row.TotalUnits.ToString("N2")</td>
                            <td>@row.AverageOpenRate.ToString("N2")</td>
                            <td>@row.CurrentRate.ToString("N2")</td>
                            <td class="@(row.TotalPnL >= 0 ? "text-success" : "text-danger")">@row.TotalPnL.ToString("N2")</td>
                            <td class="@(row.ProfitPercent >= 0 ? "text-success" : "text-danger")">@row.ProfitPercent.ToString("N2") %</td>
                            <td>@(row.LastTimestamp?.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private PortfolioSnapshot? _snapshot;
    private List<PortfolioGroupedRowDto> _groupedRows = new();

    private readonly Dictionary<int, bool> _expandedRows = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private int _refreshIntervalSeconds;

    private string _selectedCategory = "TUTTI";

    protected override async Task OnInitializedAsync()
    {
        _refreshIntervalSeconds = Math.Max(1, EtoroOptionsMonitor.CurrentValue.RefreshIntervalSeconds);

        await LoadSnapshotAsync();

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));

        _ = StartRefreshLoopAsync(_cts.Token);
    }

    private async Task StartRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadSnapshotAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task LoadSnapshotAsync()
    {
        _snapshot = PortfolioState.GetSnapshot();
        _groupedRows = BuildGroupedRows(_snapshot);
        return Task.CompletedTask;
    }

    private void SetCategoryFilter(string category)
    {
        _selectedCategory = category;
    }

    private bool IsSelectedCategory(string category)
    {
        return string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase);
    }

    private List<PortfolioGroupedRowDto> GetFilteredRows()
    {
        if (string.Equals(_selectedCategory, "TUTTI", StringComparison.OrdinalIgnoreCase))
            return _groupedRows.OrderBy(x => x.Symbol).ToList();

        if (string.Equals(_selectedCategory, "ETF", StringComparison.OrdinalIgnoreCase))
        {
            return _groupedRows
                .Where(x => x.Category.Contains("ETF", StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Symbol)
                .ToList();
        }

        if (string.Equals(_selectedCategory, "AZIONI", StringComparison.OrdinalIgnoreCase))
        {
            return _groupedRows
                .Where(x =>
                    x.Category.Contains("STOCK", StringComparison.OrdinalIgnoreCase) ||
                    x.Category.Contains("STOCKS", StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Symbol)
                .ToList();
        }

        return _groupedRows.OrderBy(x => x.Symbol).ToList();
    }

    private void ToggleRow(int instrumentId)
    {
        if (_expandedRows.ContainsKey(instrumentId))
            _expandedRows[instrumentId] = !_expandedRows[instrumentId];
        else
            _expandedRows[instrumentId] = true;
    }

    private bool IsExpanded(int instrumentId)
    {
        return _expandedRows.TryGetValue(instrumentId, out var expanded) && expanded;
    }

    private static List<PortfolioGroupedRowDto> BuildGroupedRows(PortfolioSnapshot snapshot)
    {
        return snapshot.Positions
            .GroupBy(p => p.InstrumentId)
            .Select(group =>
            {
                var totalInvested = group.Sum(x => x.InvestedAmount);
                var totalUnits = group.Sum(x => x.Units);
                var totalPnL = group.Sum(x => x.NetProfit);

                var weightedOpenRate = totalInvested == 0
                    ? 0
                    : group.Sum(x => x.OpenRate * x.InvestedAmount) / totalInvested;

                var directions = group.Select(x => x.IsBuy ? "LONG" : "SHORT").Distinct().ToList();
                var direction = directions.Count == 1 ? directions[0] : "MIXED";

                var symbol = group.Select(x => x.Symbol).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? group.Key.ToString();
                var instrumentName = group.Select(x => x.InstrumentName).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? $"Strumento {group.Key}";
                var instrumentTypeId = group.Select(x => x.InstrumentTypeId).FirstOrDefault(x => x > 0);
                var instrumentTypeDescription = group.Select(x => x.InstrumentTypeDescription).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "N/D";

                return new PortfolioGroupedRowDto
                {
                    InstrumentId = group.Key,
                    Symbol = symbol,
                    InstrumentName = instrumentName,
                    Category = instrumentTypeDescription.ToUpperInvariant(),
                    InstrumentTypeId = instrumentTypeId,
                    Direction = direction,
                    PositionsCount = group.Count(),
                    TotalInvested = totalInvested,
                    TotalUnits = totalUnits,
                    AverageOpenRate = Math.Round(weightedOpenRate, 2),
                    CurrentRate = Math.Round(group.Where(x => x.CurrentRate != 0m).Select(x => x.CurrentRate).LastOrDefault(), 2),
                    TotalPnL = Math.Round(totalPnL, 2),
                    ProfitPercent = totalInvested == 0 ? 0 : Math.Round(totalPnL / totalInvested * 100m, 2),
                    LastTimestamp = group.Max(x => x.Timestamp)
                };
            })
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}