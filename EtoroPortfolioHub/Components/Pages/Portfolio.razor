@page "/portfolio"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.Services
@using EtoroPortfolioHub.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@attribute [Authorize]
@inject UserPortfolioService UserPortfolioService
@inject IOptionsMonitor<EtoroOptions> EtoroOptionsMonitor
@implements IAsyncDisposable

<PageTitle>Portfolio</PageTitle>

<h3 class="mb-3">Portafoglio</h3>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <span class="badge text-bg-secondary">
        Refresh ogni @_refreshIntervalSeconds secondi
    </span>

    <button class="btn btn-outline-primary btn-sm"
            @onclick="RefreshSnapshotAsync"
            disabled="@_isRefreshing">
        @(_isRefreshing ? "Aggiornamento..." : "Aggiorna ora")
    </button>
</div>

@if (_isLoading)
{
    <div class="alert alert-info">
        Caricamento dati portafoglio...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-warning">
        <div class="fw-semibold mb-1">Portafoglio non disponibile</div>
        <div>@_errorMessage</div>

        <div class="mt-3">
            <a class="btn btn-primary btn-sm" href="/settings/etoro">
                Configura account eToro
            </a>
        </div>
    </div>
}
else if (_snapshot is null)
{
    <div class="alert alert-info">
        Nessun dato disponibile.
    </div>
}
else
{
    var filteredRows = GetFilteredRows();

    <PortfolioSummaryCards Snapshot="_snapshot"
                           TitlesCount="filteredRows.Count"
                           TotalPositions="filteredRows.Sum(x => x.PositionsCount)"
                           TotalInvested="filteredRows.Sum(x => x.TotalInvested)" />

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <strong>Ultimo aggiornamento locale:</strong>
                    @_snapshot.LastUpdated.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")
                </div>

                <div class="btn-group" role="group" aria-label="Filtro categoria">
                    <button type="button"
                            class="btn @(IsSelectedCategory("TUTTI") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("TUTTI")'>
                        TUTTI
                    </button>

                    <button type="button"
                            class="btn @(IsSelectedCategory("ETF") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("ETF")'>
                        ETF
                    </button>

                    <button type="button"
                            class="btn @(IsSelectedCategory("AZIONI") ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetCategoryFilter("AZIONI")'>
                        AZIONI
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (filteredRows.Count == 0)
    {
        <div class="alert alert-warning">
            Nessun titolo disponibile per il filtro selezionato.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Titolo</th>
                        <th>Categoria</th>
                        <th>Direzione</th>
                        <th>Posizioni</th>
                        <th>Totale investito</th>
                        <th>Totale units</th>
                        <th>Prezzo medio</th>
                        <th>Prezzo attuale</th>
                        <th>P/L totale</th>
                        <th>P/L %</th>
                        <th>Ultima apertura</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in filteredRows)
                    {
                        <tr class="@(IsExpanded(row.InstrumentId) ? "table-active" : "")">
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="Espandi / comprimi"
                                        @onclick='() => ToggleRow(row.InstrumentId)'>
                                    @(IsExpanded(row.InstrumentId) ? "−" : "+")
                                </button>
                            </td>

                            <td>
                                <div><strong>@row.Symbol</strong></div>
                                <div class="text-muted small">@row.InstrumentName</div>
                                <div class="text-muted small">ID: @row.InstrumentId</div>
                            </td>

                            <td>
                                <span class="badge @(row.Category == "ETF" ? "text-bg-info" : row.Category == "AZIONI" ? "text-bg-secondary" : "text-bg-light")">
                                    @row.Category
                                </span>
                            </td>

                            <td>@row.Direction</td>
                            <td>@row.PositionsCount</td>
                            <td>@row.TotalInvested.ToString("N2")</td>
                            <td>@row.TotalUnits.ToString("N2")</td>
                            <td>@row.AverageOpenRate.ToString("N2")</td>
                            <td>@row.CurrentRate.ToString("N2")</td>
                            <td class="@(row.TotalPnL >= 0 ? "text-success" : "text-danger")">
                                @row.TotalPnL.ToString("N2")
                            </td>
                            <td class="@(row.ProfitPercent >= 0 ? "text-success" : "text-danger")">
                                @row.ProfitPercent.ToString("N2") %
                            </td>
                            <td>
                                @(row.LastTimestamp?.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                            </td>
                        </tr>

                        @if (IsExpanded(row.InstrumentId))
                        {
                            var allDetails = GetDetailsForInstrument(row.InstrumentId);
                            var totalPages = GetTotalDetailPages(allDetails.Count);
                            var currentPage = GetCurrentDetailPage(row.InstrumentId, totalPages);
                            var details = GetPagedDetailsForInstrument(allDetails, currentPage);

                            <tr>
                                <td colspan="12" class="bg-light">
                                    <div class="p-2">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
                                            <div class="fw-semibold">
                                                Dettaglio posizioni - @row.Symbol (@allDetails.Count)
                                            </div>

                                            @if (totalPages > 1)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            @onclick='() => GoToDetailPage(row.InstrumentId, currentPage - 1)'
                                                            disabled="@(currentPage <= 1)">
                                                        Precedente
                                                    </button>

                                                    <span class="small text-muted">
                                                        Pagina @currentPage di @totalPages
                                                    </span>

                                                    <button class="btn btn-sm btn-outline-secondary"
                                                            @onclick='() => GoToDetailPage(row.InstrumentId, currentPage + 1)'
                                                            disabled="@(currentPage >= totalPages)">
                                                        Successiva
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        @if (allDetails.Count == 0)
                                        {
                                            <div class="text-muted">Nessun dettaglio disponibile.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mb-2">
                                                Mostrate @details.Count posizioni su @allDetails.Count totali
                                                (50 per pagina)
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Position ID</th>
                                                            <th>Direzione</th>
                                                            <th>Investito</th>
                                                            <th>Units</th>
                                                            <th>Open Rate</th>
                                                            <th>Prezzo attuale</th>
                                                            <th>Leverage</th>
                                                            <th>Take Profit</th>
                                                            <th>Stop Loss</th>
                                                            <th>P/L</th>
                                                            <th>P/L %</th>
                                                            <th>Timestamp</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var position in details)
                                                        {
                                                            <tr>
                                                                <td>@position.PositionId</td>
                                                                <td>@(position.IsBuy ? "LONG" : "SHORT")</td>
                                                                <td>@position.InvestedAmount.ToString("N2")</td>
                                                                <td>@position.Units.ToString("N2")</td>
                                                                <td>@position.OpenRate.ToString("N2")</td>
                                                                <td>@position.CurrentRate.ToString("N2")</td>
                                                                <td>@position.Leverage.ToString("N2")</td>
                                                                <td>@position.TakeProfitRate.ToString("N2")</td>
                                                                <td>@position.StopLossRate.ToString("N2")</td>
                                                                <td class="@(position.NetProfit >= 0 ? "text-success" : "text-danger")">
                                                                    @position.NetProfit.ToString("N2")
                                                                </td>
                                                                <td class="@(position.ProfitPercent >= 0 ? "text-success" : "text-danger")">
                                                                    @position.ProfitPercent.ToString("N2") %
                                                                </td>
                                                                <td>
                                                                    @(position.Timestamp?.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (totalPages > 1)
                                            {
                                                <div class="d-flex justify-content-end mt-3">
                                                    <div class="btn-group" role="group">
                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                @onclick='() => GoToDetailPage(row.InstrumentId, currentPage - 1)'
                                                                disabled="@(currentPage <= 1)">
                                                            Precedente
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-secondary" disabled>
                                                            Pagina @currentPage / @totalPages
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-secondary"
                                                                @onclick='() => GoToDetailPage(row.InstrumentId, currentPage + 1)'
                                                                disabled="@(currentPage >= totalPages)">
                                                            Successiva
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const int DetailPageSize = 50;

    private PortfolioSnapshot? _snapshot;
    private List<PortfolioGroupedRowDto> _groupedRows = new();

    private readonly Dictionary<int, bool> _expandedRows = new();
    private readonly Dictionary<int, int> _detailPageByInstrument = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private int _refreshIntervalSeconds;

    private string _selectedCategory = "TUTTI";

    private bool _isLoading = true;
    private bool _isRefreshing;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _refreshIntervalSeconds = Math.Max(1, EtoroOptionsMonitor.CurrentValue.RefreshIntervalSeconds);

        await LoadSnapshotAsync(refreshFromEtoro: true);

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));

        _ = StartRefreshLoopAsync(_cts.Token);
    }

    private async Task StartRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadSnapshotAsync(refreshFromEtoro: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // chiusura normale del componente
        }
    }

    private async Task RefreshSnapshotAsync()
    {
        await LoadSnapshotAsync(refreshFromEtoro: true);
    }

    private async Task LoadSnapshotAsync(bool refreshFromEtoro)
    {
        _isLoading = _snapshot is null;
        _isRefreshing = true;
        _errorMessage = null;

        try
        {
            _snapshot = refreshFromEtoro
                ? await UserPortfolioService.RefreshCurrentUserSnapshotAsync()
                : await UserPortfolioService.GetCurrentUserSnapshotAsync();

            _groupedRows = BuildGroupedRows(_snapshot);

            var validIds = _groupedRows.Select(x => x.InstrumentId).ToHashSet();

            var expandedKeysToRemove = _expandedRows.Keys
                .Where(id => !validIds.Contains(id))
                .ToList();

            foreach (var key in expandedKeysToRemove)
            {
                _expandedRows.Remove(key);
            }

            var pageKeysToRemove = _detailPageByInstrument.Keys
                .Where(id => !validIds.Contains(id))
                .ToList();

            foreach (var key in pageKeysToRemove)
            {
                _detailPageByInstrument.Remove(key);
            }
        }
        catch (Exception ex)
        {
            _snapshot = null;
            _groupedRows = new();
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private void SetCategoryFilter(string category)
    {
        _selectedCategory = category;
    }

    private bool IsSelectedCategory(string category)
    {
        return string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase);
    }

    private List<PortfolioGroupedRowDto> GetFilteredRows()
    {
        if (string.Equals(_selectedCategory, "TUTTI", StringComparison.OrdinalIgnoreCase))
            return _groupedRows.OrderBy(x => x.Symbol).ToList();

        return _groupedRows
            .Where(x => string.Equals(x.Category, _selectedCategory, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    private void ToggleRow(int instrumentId)
    {
        if (_expandedRows.ContainsKey(instrumentId))
        {
            _expandedRows[instrumentId] = !_expandedRows[instrumentId];
        }
        else
        {
            _expandedRows[instrumentId] = true;
        }

        if (!_detailPageByInstrument.ContainsKey(instrumentId))
        {
            _detailPageByInstrument[instrumentId] = 1;
        }
    }

    private bool IsExpanded(int instrumentId)
    {
        return _expandedRows.TryGetValue(instrumentId, out var expanded) && expanded;
    }

    private int GetCurrentDetailPage(int instrumentId, int totalPages)
    {
        if (!_detailPageByInstrument.TryGetValue(instrumentId, out var currentPage))
        {
            currentPage = 1;
            _detailPageByInstrument[instrumentId] = currentPage;
        }

        if (currentPage < 1)
            currentPage = 1;

        if (totalPages > 0 && currentPage > totalPages)
            currentPage = totalPages;

        _detailPageByInstrument[instrumentId] = currentPage;

        return currentPage;
    }

    private void GoToDetailPage(int instrumentId, int page)
    {
        if (page < 1)
            page = 1;

        _detailPageByInstrument[instrumentId] = page;
    }

    private int GetTotalDetailPages(int totalItems)
    {
        if (totalItems <= 0)
            return 1;

        return (int)Math.Ceiling(totalItems / (double)DetailPageSize);
    }

    private List<PositionDto> GetDetailsForInstrument(int instrumentId)
    {
        if (_snapshot is null)
            return new List<PositionDto>();

        return _snapshot.Positions
            .Where(p => p.InstrumentId == instrumentId)
            .OrderByDescending(p => p.Timestamp)
            .ThenByDescending(p => p.PositionId)
            .ToList();
    }

    private static List<PositionDto> GetPagedDetailsForInstrument(List<PositionDto> allDetails, int page)
    {
        var skip = (page - 1) * DetailPageSize;

        return allDetails
            .Skip(skip)
            .Take(DetailPageSize)
            .ToList();
    }

    private static List<PortfolioGroupedRowDto> BuildGroupedRows(PortfolioSnapshot snapshot)
    {
        return snapshot.Positions
            .GroupBy(p => p.InstrumentId)
            .Select(group =>
            {
                var totalInvested = group.Sum(x => x.InvestedAmount);
                var totalUnits = group.Sum(x => x.Units);
                var totalPnL = group.Sum(x => x.NetProfit);

                var weightedOpenRate = totalInvested == 0m
                    ? 0m
                    : group.Sum(x => x.OpenRate * x.InvestedAmount) / totalInvested;

                var directions = group.Select(x => x.IsBuy ? "LONG" : "SHORT").Distinct().ToList();
                var direction = directions.Count == 1 ? directions[0] : "MIXED";

                var symbol =
                    group.Select(x => x.Symbol)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? group.Key.ToString();

                var instrumentName =
                    group.Select(x => x.InstrumentName)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? $"Strumento {group.Key}";

                var instrumentTypeId =
                    group.Select(x => x.InstrumentTypeId)
                         .FirstOrDefault(x => x > 0);

                var instrumentTypeDescription =
                    group.Select(x => x.InstrumentTypeDescription)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? "N/D";

                return new PortfolioGroupedRowDto
                {
                    InstrumentId = group.Key,
                    Symbol = symbol,
                    InstrumentName = instrumentName,
                    InstrumentTypeId = instrumentTypeId,
                    Category = NormalizeCategory(instrumentTypeDescription),
                    Direction = direction,
                    PositionsCount = group.Count(),
                    TotalInvested = totalInvested,
                    TotalUnits = totalUnits,
                    AverageOpenRate = Math.Round(weightedOpenRate, 2),
                    CurrentRate = Math.Round(
                        group.Where(x => x.CurrentRate != 0m)
                             .Select(x => x.CurrentRate)
                             .LastOrDefault(),
                        2),
                    TotalPnL = Math.Round(totalPnL, 2),
                    ProfitPercent = totalInvested == 0m
                        ? 0m
                        : Math.Round(totalPnL / totalInvested * 100m, 2),
                    LastTimestamp = group.Max(x => x.Timestamp)
                };
            })
            .OrderBy(x => x.Symbol)
            .ToList();
    }

    private static string NormalizeCategory(string instrumentTypeDescription)
    {
        if (string.IsNullOrWhiteSpace(instrumentTypeDescription))
            return "ALTRO";

        var value = instrumentTypeDescription.Trim().ToUpperInvariant();

        if (value.Contains("ETF"))
            return "ETF";

        if (value.Contains("STOCK"))
            return "AZIONI";

        return value;
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();

        return ValueTask.CompletedTask;
    }
}