@page "/"
@using EtoroPortfolioHub.Models
@using EtoroPortfolioHub.Services
@using EtoroPortfolioHub.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@attribute [Authorize]
@inject UserPortfolioService UserPortfolioService
@inject PortfolioTargetService PortfolioTargetService
@inject IOptionsMonitor<EtoroOptions> EtoroOptionsMonitor
@implements IAsyncDisposable

<PageTitle>Home</PageTitle>

<h3 class="mb-3">Home</h3>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <span class="badge text-bg-secondary">
        Refresh ogni @_refreshIntervalSeconds secondi
    </span>

    <button class="btn btn-outline-primary btn-sm"
            @onclick="RefreshSnapshotAsync"
            disabled="@_isRefreshing">
        @(_isRefreshing ? "Aggiornamento..." : "Aggiorna ora")
    </button>
</div>

@if (_isLoading)
{
    <div class="alert alert-info">
        Caricamento dati portafoglio...
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-warning">
        <div class="fw-semibold mb-1">Portafoglio non disponibile</div>
        <div>@_errorMessage</div>

        <div class="mt-3">
            <a href="/settings/etoro" class="btn btn-primary btn-sm">
                Configura account eToro
            </a>
        </div>
    </div>
}
else if (_snapshot is null)
{
    <div class="alert alert-info">
        Nessun dato disponibile.
    </div>
}
else
{
    <PortfolioSummaryCards Snapshot="_snapshot"
                           TitlesCount="_titlesCount"
                           TotalPositions="_snapshot.TotalPositions"
                           TotalInvested="_totalInvested" />

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Target assegnato</div>
                    <div class="fs-4 fw-bold @(TotalTargetPercentage > 100m ? "text-danger" : "text-success")">
                        @TotalTargetPercentage.ToString("N2") %
                    </div>
                    <div class="small text-muted mt-1">
                        Su @(_rebalanceRows.Count(x => x.TargetPercentage > 0m)) titoli
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Titoli sottopeso</div>
                    <div class="fs-4 fw-bold text-success">
                        @_underWeightRows.Count
                    </div>
                    <div class="small text-muted mt-1">
                        Da incrementare rispetto al target
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Titoli sovrappeso</div>
                    <div class="fs-4 fw-bold text-danger">
                        @_overWeightRows.Count
                    </div>
                    <div class="small text-muted mt-1">
                        Sopra il target impostato
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Ultimo aggiornamento</div>
                    <div class="fw-bold">
                        @_snapshot.LastUpdated.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss")
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TotalTargetPercentage > 100m)
    {
        <div class="alert alert-warning">
            Il totale dei target supera il 100%.
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Top 5 per peso attuale</h5>

                    @if (_topWeightRows.Count == 0)
                    {
                        <div class="text-muted">Nessun dato disponibile.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Titolo</th>
                                        <th class="text-end">Investito</th>
                                        <th class="text-end">Peso %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _topWeightRows)
                                    {
                                        <tr>
                                            <td>
                                                <div><strong>@row.Symbol</strong></div>
                                                <div class="text-muted small">@row.InstrumentName</div>
                                            </td>
                                            <td class="text-end">@row.CurrentInvestedAmount.ToString("N2")</td>
                                            <td class="text-end">@row.CurrentWeightPercentage.ToString("N2") %</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Top 5 performance</h5>

                    @if (_topPerformanceRows.Count == 0)
                    {
                        <div class="text-muted">Nessun dato disponibile.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Titolo</th>
                                        <th class="text-end">P/L</th>
                                        <th class="text-end">P/L %</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _topPerformanceRows)
                                    {
                                        <tr>
                                            <td>
                                                <div><strong>@row.Symbol</strong></div>
                                                <div class="text-muted small">@row.InstrumentName</div>
                                            </td>
                                            <td class="text-end @(row.TotalPnL >= 0 ? "text-success" : "text-danger")">
                                                @row.TotalPnL.ToString("N2")
                                            </td>
                                            <td class="text-end @(row.ProfitPercent >= 0 ? "text-success" : "text-danger")">
                                                @row.ProfitPercent.ToString("N2") %
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Sottopeso rispetto al target</h5>

                    @if (_underWeightRows.Count == 0)
                    {
                        <div class="text-muted">
                            Nessun titolo sottopeso rispetto al target.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Titolo</th>
                                        <th class="text-end">Peso %</th>
                                        <th class="text-end">Target %</th>
                                        <th class="text-end">Delta valore</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _underWeightRows)
                                    {
                                        <tr>
                                            <td>
                                                <div><strong>@row.Symbol</strong></div>
                                                <div class="text-muted small">@row.InstrumentName</div>
                                            </td>
                                            <td class="text-end">@row.CurrentWeightPercentage.ToString("N2") %</td>
                                            <td class="text-end">@row.TargetPercentage.ToString("N2") %</td>
                                            <td class="text-end text-success">@row.DeltaValue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Sovrappeso rispetto al target</h5>

                    @if (_overWeightRows.Count == 0)
                    {
                        <div class="text-muted">
                            Nessun titolo sovrappeso rispetto al target.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Titolo</th>
                                        <th class="text-end">Peso %</th>
                                        <th class="text-end">Target %</th>
                                        <th class="text-end">Delta valore</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _overWeightRows)
                                    {
                                        <tr>
                                            <td>
                                                <div><strong>@row.Symbol</strong></div>
                                                <div class="text-muted small">@row.InstrumentName</div>
                                            </td>
                                            <td class="text-end">@row.CurrentWeightPercentage.ToString("N2") %</td>
                                            <td class="text-end">@row.TargetPercentage.ToString("N2") %</td>
                                            <td class="text-end text-danger">@row.DeltaValue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PortfolioSnapshot? _snapshot;

    private List<HomeRebalanceRowVm> _rebalanceRows = new();
    private List<HomeRebalanceRowVm> _topWeightRows = new();
    private List<HomeRebalanceRowVm> _topPerformanceRows = new();
    private List<HomeRebalanceRowVm> _underWeightRows = new();
    private List<HomeRebalanceRowVm> _overWeightRows = new();

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private int _refreshIntervalSeconds;

    private bool _isLoading = true;
    private bool _isRefreshing;
    private string? _errorMessage;

    private int _titlesCount;
    private decimal _totalInvested;

    private decimal TotalTargetPercentage =>
        Math.Round(_rebalanceRows.Sum(x => x.TargetPercentage), 2);

    protected override async Task OnInitializedAsync()
    {
        _refreshIntervalSeconds = Math.Max(1, EtoroOptionsMonitor.CurrentValue.RefreshIntervalSeconds);

        await LoadAsync(refreshFromEtoro: true);

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));

        _ = StartRefreshLoopAsync(_cts.Token);
    }

    private async Task StartRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadAsync(refreshFromEtoro: true);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // chiusura normale del componente
        }
    }

    private async Task RefreshSnapshotAsync()
    {
        await LoadAsync(refreshFromEtoro: true);
    }

    private async Task LoadAsync(bool refreshFromEtoro)
    {
        _isLoading = _snapshot is null;
        _isRefreshing = true;
        _errorMessage = null;

        try
        {
            _snapshot = refreshFromEtoro
                ? await UserPortfolioService.RefreshCurrentUserSnapshotAsync()
                : await UserPortfolioService.GetCurrentUserSnapshotAsync();

            var savedTargets = await PortfolioTargetService.GetAllAsync();

            BuildHomeRows(_snapshot, savedTargets);
        }
        catch (Exception ex)
        {
            _snapshot = null;
            _rebalanceRows = new();
            _topWeightRows = new();
            _topPerformanceRows = new();
            _underWeightRows = new();
            _overWeightRows = new();
            _titlesCount = 0;
            _totalInvested = 0m;
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private void BuildHomeRows(
        PortfolioSnapshot snapshot,
        Dictionary<int, PortfolioTargetItem> savedTargets)
    {
        _totalInvested = snapshot.Positions.Sum(x => x.InvestedAmount);

        _rebalanceRows = snapshot.Positions
            .GroupBy(p => p.InstrumentId)
            .Select(group =>
            {
                var invested = group.Sum(x => x.InvestedAmount);
                var totalPnL = group.Sum(x => x.NetProfit);

                var symbol =
                    group.Select(x => x.Symbol)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? group.Key.ToString();

                var instrumentName =
                    group.Select(x => x.InstrumentName)
                         .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? $"Strumento {group.Key}";

                savedTargets.TryGetValue(group.Key, out var savedTarget);

                var targetPercentage = savedTarget?.TargetPercentage ?? 0m;

                var currentWeight = _totalInvested == 0m
                    ? 0m
                    : Math.Round(invested / _totalInvested * 100m, 2);

                var profitPercent = invested == 0m
                    ? 0m
                    : Math.Round(totalPnL / invested * 100m, 2);

                return new HomeRebalanceRowVm
                {
                    InstrumentId = group.Key,
                    Symbol = symbol,
                    InstrumentName = instrumentName,
                    CurrentInvestedAmount = invested,
                    TotalPortfolioInvested = _totalInvested,
                    CurrentWeightPercentage = currentWeight,
                    TargetPercentage = targetPercentage,
                    TotalPnL = Math.Round(totalPnL, 2),
                    ProfitPercent = profitPercent
                };
            })
            .OrderBy(x => x.Symbol)
            .ToList();

        _titlesCount = _rebalanceRows.Count;

        _topWeightRows = _rebalanceRows
            .OrderByDescending(x => x.CurrentWeightPercentage)
            .Take(5)
            .ToList();

        _topPerformanceRows = _rebalanceRows
            .OrderByDescending(x => x.ProfitPercent)
            .Take(5)
            .ToList();

        _underWeightRows = _rebalanceRows
            .Where(x => x.TargetPercentage > 0m && x.DeltaValue > 0m)
            .OrderByDescending(x => x.DeltaValue)
            .Take(10)
            .ToList();

        _overWeightRows = _rebalanceRows
            .Where(x => x.TargetPercentage > 0m && x.DeltaValue < 0m)
            .OrderBy(x => x.DeltaValue)
            .Take(10)
            .ToList();
    }

    public ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();

        return ValueTask.CompletedTask;
    }

    private sealed class HomeRebalanceRowVm
    {
        public int InstrumentId { get; set; }

        public string Symbol { get; set; } = string.Empty;
        public string InstrumentName { get; set; } = string.Empty;

        public decimal CurrentInvestedAmount { get; set; }
        public decimal TotalPortfolioInvested { get; set; }

        public decimal CurrentWeightPercentage { get; set; }
        public decimal TargetPercentage { get; set; }

        public decimal TotalPnL { get; set; }
        public decimal ProfitPercent { get; set; }

        public decimal DeltaPercentage =>
            Math.Round(TargetPercentage - CurrentWeightPercentage, 2);

        public decimal TargetValue =>
            Math.Round(TotalPortfolioInvested * TargetPercentage / 100m, 2);

        public decimal DeltaValue =>
            Math.Round(TargetValue - CurrentInvestedAmount, 2);
    }
}