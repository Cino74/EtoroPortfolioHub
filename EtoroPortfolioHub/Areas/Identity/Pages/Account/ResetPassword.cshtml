@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reimposta password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h1 class="h3 mb-2">Etoro Portfolio Hub</h1>
                        <p class="text-muted mb-0">
                            Imposta una nuova password per il tuo account.
                        </p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <input asp-for="Input.Code" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="nome@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Nuova password</label>
                            <input asp-for="Input.Password"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Nuova password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Conferma nuova password</label>
                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Conferma nuova password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            Reimposta password
                        </button>

                        <div class="text-center mt-4">
                            <a asp-page="./Login">
                                Torna al login
                            </a>
                        </div>
                    </form>

                </div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none">
                    Torna alla Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}