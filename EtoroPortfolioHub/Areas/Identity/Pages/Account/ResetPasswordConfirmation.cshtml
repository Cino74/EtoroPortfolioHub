@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password reimpostata";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">

                    <h1 class="h3 mb-3">Password reimpostata</h1>

                    <p class="text-muted mb-4">
                        La tua password è stata aggiornata correttamente.
                    </p>

                    <a asp-page="./Login" class="btn btn-primary btn-lg w-100">
                        Accedi
                    </a>

                </div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none">
                    Torna alla Home
                </a>
            </div>
        </div>
    </div>
</div>