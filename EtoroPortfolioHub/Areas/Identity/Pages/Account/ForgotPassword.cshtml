@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Email inviata";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-4">
                        <h1 class="h3 mb-2">Controlla la tua email</h1>
                        <p class="text-muted mb-0">
                            Se l’indirizzo inserito è associato a un account,
                            riceverai un link per reimpostare la password.
                        </p>
                    </div>

                    <div class="alert alert-light border text-start">
                        <strong>Nota:</strong>
                        per motivi di sicurezza non confermiamo se l’email è registrata o meno.
                    </div>

                    <a asp-page="./Login" class="btn btn-primary btn-lg w-100 mt-3">
                        Torna al login
                    </a>

                </div>
            </div>

            <div class="text-center mt-3">
                /
                Torna alla Home
            </a>
        </div>
    </div>
</div>
</div>